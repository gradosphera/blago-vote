[Unit]
Description=Blago Vote Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ton/Github/blago-vote/bot
ExecStart=/usr/local/bin/node bot.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Proxy is read from bot/.env (PROXY=...). No Tor dependency.

[Install]
WantedBy=default.target
